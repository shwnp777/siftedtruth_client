# Copy to .env.local (never commit it). Add the same values in Amplify →
# App settings → Environment variables when you deploy.

# The live address, no trailing slash. Used for share previews and the RSS feed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your YouTube channel. The footer link appears once this is set.
NEXT_PUBLIC_YOUTUBE_URL=

# Shows "Support our work" and /support. Leave false until Stripe Checkout is connected.
NEXT_PUBLIC_GIVING_ENABLED=false

# Supabase → Project Settings → API
# Leave blank and the site runs on the sample data in data/dummy.js.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Older projects: use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Later stages (not used yet)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_MEDIA_BASE_URL=https://dxxxxxxxx.cloudfront.net
