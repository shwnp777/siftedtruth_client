# Copy to .env.local (never commit it). Add the same values in Amplify →
# App settings → Environment variables when you deploy.

# Shows the "sample content" banner on the public site.
NEXT_PUBLIC_SHOW_SAMPLE_BANNER=true

# Supabase → Project Settings → API
# Leave blank and the site runs on the sample data in data/dummy.js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Later stages (not used yet)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_MEDIA_BASE_URL=https://dxxxxxxxx.cloudfront.net
